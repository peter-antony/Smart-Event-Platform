# Application Configuration
APP_NAME="Smart Event Platform API"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_event_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_event_db

# OpenAI API Key for AI Agent
OPENAI_API_KEY=your_openai_api_key_here
